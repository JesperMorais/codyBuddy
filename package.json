{
  "name": "monitor-teacher",
  "version": "0.1.0",
  "private": true,
  "description": "Live coding buddy: VS Code extension + Node daemon + Python TTS sidecar",
  "scripts": {
    "build": "pnpm -r build",
    "dev:daemon": "pnpm --filter buddy-daemon dev",
    "dev:voice": "cd voice && uvicorn main:app --port 31416 --reload",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "changelog": "node scripts/gen-changelog.mjs",
    "changelog:check": "node scripts/gen-changelog.mjs --check",
    "doctor": "node scripts/doctor.mjs",
    "build:vsix": "pnpm --filter coding-buddy-vscode build:vsix"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  }
}
