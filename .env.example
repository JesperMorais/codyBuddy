# Provider selection. "anthropic" (default) requires ANTHROPIC_API_KEY.
# "ollama" routes everything to a local OpenAI-compatible endpoint
# (default http://localhost:11434/v1) — useful for sensitive repos
# where code can't leave the machine.
BUDDY_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
BUDDY_MODEL=claude-sonnet-4-6
BUDDY_DAEMON_PORT=31415

# Ollama overrides (only used when BUDDY_PROVIDER=ollama).
BUDDY_OLLAMA_URL=http://localhost:11434/v1
BUDDY_OLLAMA_MODEL=qwen2.5-coder:32b

# Voice output backend. One of:
#   none   — VS Code webview speechSynthesis (OS voices). Default when
#            this env var is unset (preserves pre-12.6 behavior).
#   auto   — let the active personality pick the engine: drill_sergeant
#            / pirate / shakespearean / rude → XTTS-v2; everything else
#            → Kokoro. Recommended for new installs.
#   kokoro — explicit override: every personality routes to Kokoro.
#   xtts   — explicit override: every personality routes to XTTS-v2
#            (requires every personality to have an xtts_ref or the
#            sidecar will fail).
#   piper  — local Piper TTS (open source). Run voice/setup-piper.ps1 first.
# Any other value causes the daemon to exit on startup.
BUDDY_TTS_BACKEND=auto
BUDDY_PIPER_EXE=
BUDDY_PIPER_VOICE=
# Endpoint of the Kokoro FastAPI sidecar (voice/buddy_voice/main.py). Used when the
# effective engine is "kokoro" (BUDDY_TTS_BACKEND=kokoro, OR auto + a
# Kokoro personality).
BUDDY_KOKORO_URL=http://127.0.0.1:31416/tts
# Endpoint of the XTTS-v2 FastAPI sidecar (voice/buddy_voice/xtts.py). Used when
# the effective engine is "xtts" (BUDDY_TTS_BACKEND=xtts, OR auto + an
# XTTS personality such as drill_sergeant). Default works with the
# bundled sidecar.
BUDDY_XTTS_URL=http://127.0.0.1:31417/synth

# Voice loop kill-switch (Task 15.11). One of:
#   auto — full voice path enabled (default).
#   off  — chat-only install. No Python, no venv, no sidecars.
#          Even BUDDY_VAD_SPAWN=true is overridden.
# Set this with BUDDY_TTS_BACKEND=none for the minimal install.
BUDDY_VOICE_LOOP=auto

# Voice input (push-to-talk via Ctrl+Alt+V).
# Run voice/setup-whisper.ps1 first, then set the paths below.
BUDDY_WHISPER_EXE=
BUDDY_WHISPER_MODEL=

# Tone overlay applied on top of the active mode prompt.
#
# Shipped values (load on every provider):
#   nice                — neutral baseline; overlay omitted (default)
#   dry                 — deadpan, terse, lightly sardonic
#   rude                — blunt, no softeners
#   drill_sergeant      — clipped, imperative, high-tempo
#   passive_aggressive  — polite surface, pointed subtext
#   pirate              — pirate cadence
#   shakespearean       — early-modern English
#
# Special values:
#   random              — shuffle on every trigger (different personality
#                         per turn, never repeating the previous one).
#                         Same effect as ticking the sidebar Shuffle box.
#
# Gated values (require BUDDY_PROVIDER=ollama):
#   nsfw                — uncensored register; profanity allowed.
#                         UNAVAILABLE on BUDDY_PROVIDER=anthropic — the
#                         daemon refuses setPersonality("nsfw") with a
#                         clear error pointing at this env var.
#
# The chosen value is persisted to ~/.coding-buddy/personality.json and
# survives daemon restarts; this env var only seeds the *first* boot.
# Same applies to the shuffle toggle (~/.coding-buddy/shuffle.json).
BUDDY_PERSONALITY=nice

# Wake word (Task 10.8). When set, the daemon gates the LLM-forwarding
# path: transcripts are dropped until the user says the phrase, then
# pass through for a 30s active window (bumped on every follow-up
# turn so an active conversation doesn't re-gate mid-thought). When
# off (default), the daemon is open-mic always-listening.
#   off          — no wake word; every transcript reaches the LLM.
#   "hey buddy"  — the suggested default phrase.
#   <custom>     — any phrase you want, matched case-insensitively.
BUDDY_WAKEWORD=off

# Backchannel acknowledgements (Task 10.7). When the conversation loop
# is LISTENING and the user has been speaking >3s, the daemon plays a
# short pre-recorded "mhm"/"yeah"/"go on" clip locally — no LLM call.
# Cooldown ≥8s between plays. Off disables the feature entirely.
# Files live under voice/backchannels/ — see the README there.
BUDDY_BACKCHANNEL=on

# Optional Screenpipe context provider (https://github.com/screenpipe/screenpipe).
# When set, the buddy queries recent OCR'd screen activity ONLY on EXPLICIT_ASK
# triggers when the editor has no recent diff (you've been outside the IDE).
# Leave blank to disable.
BUDDY_SCREENPIPE_URL=
