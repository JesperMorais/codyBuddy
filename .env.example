ANTHROPIC_API_KEY=sk-ant-...
BUDDY_MODEL=claude-sonnet-4-6
BUDDY_DAEMON_PORT=31415

# Voice output backend. One of:
#   none   — VS Code webview speechSynthesis (OS voices). Default.
#   piper  — local Piper TTS (open source). Run voice/setup-piper.ps1 first.
#   kokoro — Kokoro TTS via the FastAPI sidecar in voice/main.py (Task 2.1).
# Any other value causes the daemon to exit on startup.
BUDDY_TTS_BACKEND=none
BUDDY_PIPER_EXE=
BUDDY_PIPER_VOICE=

# Voice input (push-to-talk via Ctrl+Alt+V).
# Run voice/setup-whisper.ps1 first, then set the paths below.
BUDDY_WHISPER_EXE=
BUDDY_WHISPER_MODEL=
