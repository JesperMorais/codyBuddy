# Provider selection. "anthropic" (default) requires ANTHROPIC_API_KEY.
# "ollama" routes everything to a local OpenAI-compatible endpoint
# (default http://localhost:11434/v1) — useful for sensitive repos
# where code can't leave the machine.
BUDDY_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
BUDDY_MODEL=claude-sonnet-4-6
BUDDY_DAEMON_PORT=31415

# Ollama overrides (only used when BUDDY_PROVIDER=ollama).
BUDDY_OLLAMA_URL=http://localhost:11434/v1
BUDDY_OLLAMA_MODEL=qwen2.5-coder:32b

# Voice output backend. One of:
#   none   — VS Code webview speechSynthesis (OS voices). Default.
#   piper  — local Piper TTS (open source). Run voice/setup-piper.ps1 first.
#   kokoro — Kokoro TTS via the FastAPI sidecar in voice/main.py (Task 2.1).
# Any other value causes the daemon to exit on startup.
BUDDY_TTS_BACKEND=none
BUDDY_PIPER_EXE=
BUDDY_PIPER_VOICE=
# Endpoint of the Kokoro FastAPI sidecar (voice/main.py). Used when BUDDY_TTS_BACKEND=kokoro.
BUDDY_KOKORO_URL=http://127.0.0.1:31416/tts

# Voice input (push-to-talk via Ctrl+Alt+V).
# Run voice/setup-whisper.ps1 first, then set the paths below.
BUDDY_WHISPER_EXE=
BUDDY_WHISPER_MODEL=

# Optional Screenpipe context provider (https://github.com/screenpipe/screenpipe).
# When set, the buddy queries recent OCR'd screen activity ONLY on EXPLICIT_ASK
# triggers when the editor has no recent diff (you've been outside the IDE).
# Leave blank to disable.
BUDDY_SCREENPIPE_URL=
