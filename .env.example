ANTHROPIC_API_KEY=sk-ant-...
BUDDY_MODEL=claude-sonnet-4-6
BUDDY_DAEMON_PORT=31415

# Voice output. "none" = use VS Code webview speechSynthesis (OS voices).
# "piper" = local Piper TTS (open source). Run voice/setup-piper.ps1 first.
BUDDY_TTS_BACKEND=none
BUDDY_PIPER_EXE=
BUDDY_PIPER_VOICE=

# Voice input (push-to-talk via Ctrl+Alt+V).
# Run voice/setup-whisper.ps1 first, then set the paths below.
BUDDY_WHISPER_EXE=
BUDDY_WHISPER_MODEL=
